# Copy this file to the project-root .env and set a unique SECRET_KEY.
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection (required; the app no longer uses SQLite)
DB_NAME=fine_grained_permissions
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Optional: credentials for `manage.py set_initial_permission_admin`.
# The command never prints the password. Leave unset to skip the command.
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=
