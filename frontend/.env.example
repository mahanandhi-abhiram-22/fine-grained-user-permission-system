# Base URL of the Django API.
#
# Copy this file to `.env` in this same directory to override the default. Vite
# only exposes variables prefixed with VITE_ to the browser bundle, and only
# from a file named `.env` inside this frontend directory.
#
# The frontend falls back to http://127.0.0.1:8000/api when this is unset, so
# `npm run dev` works against a backend on the default Django port without any
# extra configuration. Do not commit the real `.env`.
#
# Do not put secrets here: everything in this file is shipped to the browser.
VITE_API_URL=http://127.0.0.1:8000/api